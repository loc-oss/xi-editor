# --- Rust ---
# Compiled files and executables
debug/
target/

# Cargo.lock rules (ignore in sub-crates, track for syntect-plugin)
*/Cargo.lock
!/syntect-plugin/Cargo.lock

# Syntect plugin specific output
/syntect-plugin/out

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds (debugging information)
*.pdb

# Generated by cargo mutants (mutation testing data)
**/mutants.out*/

# rustc stack traces on internal compiler error
rustc-ice-*.txt

# --- IDEs & Editors ---
.idea/
.vscode/

# --- macOS ---
.DS_Store
xcuserdata/

# --- Python (legacy, remove if python/ is deleted) ---
*.pyc
__pycache__/
.cache/

# --- Legacy build ---
build/
